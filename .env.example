# Copy this file to .env and adjust. Never commit .env.

# --- Django -------------------------------------------------------------
# Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# CSRF_TRUSTED_ORIGINS=https://scraper.example.internal
TIME_ZONE=UTC

# --- Storage ------------------------------------------------------------
# Only SQLite is supported in this version. Relative paths are relative to the project root.
DATABASE_URL=sqlite:///db.sqlite3
EXPORT_DIR=exports

# --- Scraper ------------------------------------------------------------
# mock       = simulated groups/posts, Facebook is never contacted (safe for demos and development)
# playwright = real Chromium with your own logged-in browser profile
SCRAPER_MODE=mock
BROWSER_PROFILE_DIR=browser_data/facebook_profile

# A run whose worker has not reported progress for this many seconds is treated as crashed.
SCRAPER_STALE_AFTER_SECONDS=180

# Python console logging for the scraper/dashboard loggers (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
